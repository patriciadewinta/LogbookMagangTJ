# Salin jadi .env (lokal, untuk prisma) dan .env.local (lokal, untuk Next.js),
# lalu isi nilainya. Untuk Vercel: Project → Settings → Environment Variables.
#
# PENTING: KETIK MANUAL. Jangan copy-paste dari Word/Notepad/dokumen — nilai
# yang di-paste sering membawa BOM (U+FEFF) yang bikin build Vercel gagal
# dengan pesan "Cannot convert argument to a ByteString ... value of 65279".
# (Kode sudah menyaringnya di lib/env.ts, tapi lebih baik bersih dari sumber.)

# ── Database (Supabase Postgres) ──────────────────────────────────────────
# PENTING: pakai SESSION pooler (port 5432), BUKAN transaction pooler (6543).
# Transaction pooler terukur ~375ms/query vs ~76ms di session mode.
# Tambahkan ?connection_limit=5 supaya tidak kena error EMAXCONNSESSION.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=5"

# Koneksi langsung untuk `prisma migrate` / `prisma db push`.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase (auth & storage) ─────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Service Role — HANYA server-side. JANGAN pernah dipakai di komponen client.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── Aplikasi ──────────────────────────────────────────────────────────────
# URL publik app. Dipakai untuk link TTD email, QR verifikasi, dan link
# set/reset password. WAJIB tanpa trailing slash.
# Dev:    http://localhost:3000
# Vercel: https://<nama-project>.vercel.app  (atau domain sendiri)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────
# Buat App Password di https://myaccount.google.com/apppasswords (butuh 2FA).
# Ini BUKAN password Gmail biasa. 16 huruf, spasi di tengah akan dibuang.
GMAIL_USER="nama@gmail.com"
GMAIL_APP_PASSWORD="abcdefghijklmnop"
# Opsional — kalau kosong dipakai "Logbook Magang <GMAIL_USER>".
EMAIL_FROM="Logbook Magang <nama@gmail.com>"

# ── Opsional ──────────────────────────────────────────────────────────────
# Webhook Power Automate (untuk notifikasi adaptif/email tahap lanjut).
# Kosongkan kalau belum dipakai — notifyPowerAutomate() langsung return false.
POWER_AUTOMATE_WEBHOOK_URL=""

# Path Chrome/Edge lokal untuk generate PDF di dev. Di Vercel diabaikan
# (otomatis pakai @sparticuz/chromium).
# CHROME_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
